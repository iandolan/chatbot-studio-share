# --- Core ---
SECRET_KEY=change-me-to-something-long-and-random
ADMIN_PASSWORD=            # empty = dashboard open to anyone (dev only!)

# --- LLM providers (set at least one) ---
# One OPENROUTER_API_KEY covers chat AND embeddings (OpenRouter serves
# openai/text-embedding-3-small). A direct OPENAI_API_KEY, when present, is
# preferred for embeddings because existing vectors were produced there.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=        # https://openrouter.ai, one key, every model

DEFAULT_PROVIDER=openrouter    # openrouter | openai | anthropic | gemini
DEFAULT_MODEL=                 # empty = provider default (anthropic/claude-haiku-4.5 for
                               #  openrouter / gpt-4o-mini / claude-haiku-4-5 / gemini-flash)
EMBEDDING_MODEL=text-embedding-3-small

# --- Runaway-spend protection ---
# Global cap on real LLM chat calls per UTC day, across ALL bots (embeddings
# and mock mode are never counted). When reached, bots serve their fallback
# message until midnight UTC and the dashboard shows a budget banner.
# 0 or unset = no cap.
GLOBAL_DAILY_LLM_CALLS=2000

# --- Storage / URLs ---
DATABASE_PATH=             # default: ./data/chatbot_studio.db
PUBLIC_BASE_URL=           # e.g. https://bots.yourdomain.com (used in embed snippets)

# --- Optional: lead email alerts ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Scheduled re-crawls ---
# SCHEDULER_INTERVAL_MINUTES=30   # how often the re-crawl scheduler checks for due sources
# RUN_SCHEDULER=0                 # disable the background scheduler entirely

# --- Dev switches ---
# MOCK_LLM=1               # force mock AI mode (auto-on when no provider key is set)
# CRAWLER_ALLOW_PRIVATE=1  # let the training crawler hit localhost/private IPs

# Production containers enforce a dashboard password and a unique session secret.
PRODUCTION=0
# Set only when the application is reachable exclusively through this many trusted proxies.
TRUSTED_PROXY_HOPS=0
# Private-bot access tokens expire after 12 hours and revoke on passphrase changes.
ACCESS_TOKEN_TTL=43200
# Optional HMAC-SHA256 signing secret shared with webhook receivers.
WEBHOOK_SIGNING_SECRET=

# Which provider serves embeddings: openrouter, openai or auto. Pin it, so a
# stale or revoked key on the other provider cannot silently take over.
EMBEDDING_PROVIDER=openrouter

# CC'd on every alert (leads, handoffs, gap digests, budget, health check).
# Per-bot alert addresses go to the brand; this is the owner's backstop.
ALERT_CC=you@example.com

# Hosts the crawler may reach on private IPs: sites on this same VPS, routed
# via extra_hosts in docker-compose.yml. Keep the two lists in step.
CRAWLER_PRIVATE_ALLOWLIST=example.com,www.example.com
